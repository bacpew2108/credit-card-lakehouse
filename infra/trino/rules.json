{
  "catalogs": [
    {"group": "engineer", "catalog": ".*", "allow": "all"},
    {"group": "analyst", "catalog": "(gold|ops|system)", "allow": "read-only"},
    {"catalog": ".*", "allow": "none"}
  ],
  "schemas": [
    {"group": "engineer", "owner": true},
    {"group": "analyst", "owner": false}
  ],
  "tables": [
    {"group": "engineer", "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE", "OWNERSHIP", "GRANT_SELECT"]},
    {"group": "analyst", "catalog": "gold", "schema": "card", "privileges": ["SELECT"]},
    {"group": "analyst", "catalog": "ops", "schema": "pipeline", "privileges": ["SELECT"]},
    {"group": "analyst", "catalog": "system", "privileges": ["SELECT"]},
    {"privileges": []}
  ]
}
