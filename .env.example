# Sao chép thành .env rồi thay các giá trị change_me: make env && make secrets

# MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me
# Tài khoản dịch vụ (minio-init tạo) cho Lakekeeper, Spark, Trino – không dùng root
MINIO_ACCESS_KEY=lakehouse-svc
MINIO_SECRET_KEY=change_me

# Lakekeeper (Iceberg REST Catalog) – database trong postgres-meta
LAKEKEEPER_DB_USER=lakekeeper
LAKEKEEPER_DB_PASSWORD=change_me
LAKEKEEPER_DB_NAME=lakekeeper
LAKEKEEPER_ENCRYPTION_KEY=change_me

# postgres-meta (1 instance cho Lakekeeper, Airflow, Superset)
META_DB_ADMIN_USER=meta_admin
META_DB_ADMIN_PASSWORD=change_me

# Superset Postgres
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=change_me
SUPERSET_DB_NAME=superset
SUPERSET_SECRET_KEY=change_me

# Trino (Superset datasource)
TRINO_USER=admin
TRINO_CATALOG=lakehouse
TRINO_SCHEMA=default

# Airflow Postgres
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# Airflow Admin
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Airflow Secrets
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_SECRET_KEY=change_me
AIRFLOW_JWT_SECRET=change_me

# Superset
SUPERSET_ADMIN_PASSWORD=change_me

# Hệ thống nguồn giả lập core_card
SOURCE_DB_USER=core
SOURCE_DB_PASSWORD=change_me
SOURCE_DB_NAME=core_card
# Cổng trên máy host để seed_source.py kết nối (5432/5433 hay bị chiếm)
SOURCE_DB_HOST_PORT=5434

# Khóa token hóa số thẻ: card_token = HMAC-SHA256(HMAC_SECRET, card_number)
# Không commit, không đổi sau khi đã nạp dữ liệu (đổi khóa = đổi toàn bộ token)
HMAC_SECRET=change_me
